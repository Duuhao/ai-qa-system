# API Gateway Dockerfile
FROM openjdk:17-jdk-slim

WORKDIR /app

# 安装 Maven
RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

# 复制整个后端项目
COPY backend-services/ ./backend-services/

# 在父模块下构建 api-gateway
WORKDIR /app/backend-services
RUN mvn -pl api-gateway -am clean package -DskipTests -Dmaven.compiler.source=17 -Dmaven.compiler.target=17 -U

# 运行应用
EXPOSE 8080
CMD ["java", "-jar", "api-gateway/target/api-gateway-1.0-SNAPSHOT.jar"]
