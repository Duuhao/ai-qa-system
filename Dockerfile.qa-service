# QA Service Dockerfile
FROM openjdk:17-jdk-slim

WORKDIR /app

# 安装 Maven
RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

# 复制整个后端项目
COPY backend-services/ ./backend-services/

# 在父模块下构建 qa-service
WORKDIR /app/backend-services
RUN mvn -pl qa-service -am clean package -DskipTests -Dmaven.compiler.source=17 -Dmaven.compiler.target=17 -U

# 运行应用
EXPOSE 8082
CMD ["java", "-jar", "qa-service/target/qa-service-1.0-SNAPSHOT.jar"]
