# User Service Dockerfile
FROM openjdk:17-jdk-slim

WORKDIR /app

# 安装 Maven
RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

# 复制父POM文件
COPY backend-services/pom.xml ./

# 复制user-service的POM文件
COPY backend-services/user-service/pom.xml ./user-service/

# 下载依赖（利用Docker缓存层）
RUN cd user-service && mvn dependency:go-offline -B

# 复制源代码
COPY backend-services/user-service/src ./user-service/src

# 构建应用
WORKDIR /app/user-service
RUN mvn clean package -DskipTests -Dmaven.compiler.source=17 -Dmaven.compiler.target=17 -U

# 运行应用
EXPOSE 8081
CMD ["java", "-jar", "target/user-service-1.0-SNAPSHOT.jar"]
