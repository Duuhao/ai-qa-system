# User Service Dockerfile
FROM openjdk:17-jdk-slim

WORKDIR /app

# 安装 Maven
RUN apt-get update && apt-get install -y maven && rm -rf /var/lib/apt/lists/*

# 复制所有文件
COPY backend-services/user-service/ .

# 构建应用
RUN mvn clean package -DskipTests -Dmaven.compiler.source=17 -Dmaven.compiler.target=17 -U

# 运行应用
EXPOSE 8081
CMD ["java", "-jar", "target/user-service-1.0-SNAPSHOT.jar"]
